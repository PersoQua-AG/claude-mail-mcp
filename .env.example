# claude-mail-mcp v0.2 — only transport-level config lives here.
# Mailbox credentials (IMAP, SMTP, CalDAV) are stored in accounts.json
# and managed via the OAuth shim's /settings UI.

# --- Server ---
# Interface to bind on. Default 127.0.0.1 (loopback only). nginx/Caddy
# terminates TLS upstream. Set to 0.0.0.0 only if you really want this
# process directly internet-reachable.
HOST=127.0.0.1
PORT=3220
PUBLIC_URL=https://mcp-mail.example.com
# debug | info | warn | error
LOG_LEVEL=info

# --- Authentication ---
# Bearer token clients must send in `Authorization: Bearer <token>` to call /mcp.
# In production: the OAuth shim injects this on behalf of the user after
# verifying their OAuth token. The shim reads the SAME token from
# UPSTREAM_BEARER_FILE — keep both in sync.
# Generate with: openssl rand -hex 32
AUTH_TOKEN=

# --- Accounts ---
# Path to the multi-account credentials file. The OAuth shim writes here
# when you add/edit an account via the /settings UI. The backend re-reads
# the file via fs.watch, so changes apply without a restart.
#
# Default suits a single-host deployment with the OAuth shim. For local
# development, point this somewhere in your home directory.
ACCOUNTS_FILE=/root/.config/mail-mcp/accounts.json

# --- Attachments ---
# Where get_attachment writes files. Hard-wired on purpose: there is no
# per-call target path, because mail content can carry prompt injection.
# Default: ~/Downloads/claude-mail
ATTACHMENT_DIR=
# Attachments larger than this are refused before any byte is streamed.
MAX_ATTACHMENT_MB=25
